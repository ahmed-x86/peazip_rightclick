{
  "project_name": "PeaZipMenu",
  "target_file_managers": [
    "nautilus",
    "nemo",
    "dolphin",
    "thunar",
    "pcmanfm",
    "caja"
  ],
  "menu": {
    "title": {
      "en": "PeaZip",
      "ar": "بيزيب"
    },
    "icon": "peazip",
    "directories": true,
    "items": [
      {
        "name": {
          "en": "Open Archive",
          "ar": "فتح الأرشيف"
        },
        "command": "peazip -ext2browse %file",
        "requires_binary": "peazip",
        "icon": "peazip",
        "supported_extensions": [
          ".zip",
          ".7z",
          ".rar",
          ".tar",
          ".gz",
          ".bz2",
          ".xz",
          ".zst",
          ".tgz",
          ".tbz2",
          ".txz",
          ".tzst",
          ".001",
          ".iso",
          ".cab",
          ".arj"
        ],
        "max_files": 1
      },
      {
        "group": {
          "en": "Extract",
          "ar": "استخراج"
        },
        "icon": "archive-extract",
        "items": [
          {
            "name": {
              "en": "Extract Here",
              "ar": "استخراج هنا"
            },
            "command": "peazip -ext2here %file",
            "requires_binary": "peazip",
            "icon": "archive-extract",
            "supported_extensions": [
              ".zip",
              ".7z",
              ".rar",
              ".tar",
              ".gz",
              ".bz2",
              ".xz",
              ".zst",
              ".tgz",
              ".tbz2",
              ".txz",
              ".tzst",
              ".001",
              ".iso",
              ".cab",
              ".arj"
            ],
            "max_files": 20
          },
          {
            "name": {
              "en": "Extract to Folder",
              "ar": "استخراج إلى مجلد"
            },
            "command": "peazip -ext2newfolder %file",
            "requires_binary": "peazip",
            "icon": "folder-new",
            "supported_extensions": [
              ".zip",
              ".7z",
              ".rar",
              ".tar",
              ".gz",
              ".bz2",
              ".xz",
              ".zst",
              ".tgz",
              ".tbz2",
              ".txz",
              ".tzst",
              ".001",
              ".iso",
              ".cab",
              ".arj"
            ],
            "max_files": 20
          },
          {
            "name": {
              "en": "Extract to... (Choose Folder)",
              "ar": "استخراج إلى... (اختيار المجلد)"
            },
            "command": "fm=$(xdg-mime query default inode/directory 2>/dev/null); case \"$fm\" in *dolphin*|*kde*|*qt*|*konqueror*) pick=kdialog;; *) pick=zenity;; esac; command -v \"$pick\" >/dev/null 2>&1 || { pick=zenity; command -v zenity >/dev/null 2>&1 || pick=kdialog; }; if [ \"$pick\" = kdialog ]; then out=$(kdialog --getexistingdirectory %dir/); else out=$(zenity --file-selection --directory --title=\"PeaZip\" --filename=%dir/); fi; [ -n \"$out\" ] && peazip -ext2here -o \"$out\" %file",
            "requires_binary": "peazip",
            "icon": "folder-open",
            "supported_extensions": [
              ".zip",
              ".7z",
              ".rar",
              ".tar",
              ".gz",
              ".bz2",
              ".xz",
              ".zst",
              ".tgz",
              ".tbz2",
              ".txz",
              ".tzst",
              ".001",
              ".iso",
              ".cab",
              ".arj"
            ],
            "max_files": 1,
            "shell": true
          },
          {
            "name": {
              "en": "Extract with Options...",
              "ar": "استخراج بخيارات..."
            },
            "command": "peazip -ext2main %file",
            "requires_binary": "peazip",
            "icon": "preferences-system",
            "supported_extensions": [
              ".zip",
              ".7z",
              ".rar",
              ".tar",
              ".gz",
              ".bz2",
              ".xz",
              ".zst",
              ".tgz",
              ".tbz2",
              ".txz",
              ".tzst",
              ".001",
              ".iso",
              ".cab",
              ".arj"
            ],
            "max_files": 20
          },
          {
            "name": {
              "en": "Test Archive",
              "ar": "فحص الأرشيف"
            },
            "command": "peazip -ext2test %file",
            "requires_binary": "peazip",
            "icon": "emblem-ok-symbolic",
            "supported_extensions": [
              ".zip",
              ".7z",
              ".rar",
              ".tar",
              ".gz",
              ".bz2",
              ".xz",
              ".zst",
              ".tgz",
              ".tbz2",
              ".txz",
              ".tzst",
              ".001",
              ".iso",
              ".cab",
              ".arj"
            ],
            "max_files": 20
          }
        ]
      },
      {
        "group": {
          "en": "Add to Archive",
          "ar": "إضافة لأرشيف"
        },
        "icon": "archive-insert",
        "items": [
          {
            "name": {
              "en": "Add to Archive...",
              "ar": "إضافة لأرشيف... (خيارات)"
            },
            "command": "peazip -add2archive %file",
            "requires_binary": "peazip",
            "icon": "archive-insert",
            "supported_extensions": [],
            "max_files": 100
          },
          {
            "name": {
              "en": "Add to ZIP",
              "ar": "إضافة إلى ZIP"
            },
            "command": "peazip -add2zip %file",
            "requires_binary": "peazip",
            "icon": "package-x-generic",
            "supported_extensions": [],
            "max_files": 100
          },
          {
            "name": {
              "en": "Add to 7Z",
              "ar": "إضافة إلى 7Z"
            },
            "command": "peazip -add27z %file",
            "requires_binary": "peazip",
            "icon": "package-x-generic",
            "supported_extensions": [],
            "max_files": 100
          },
          {
            "group": {
              "en": "Other Formats",
              "ar": "صيغ أخرى"
            },
            "icon": "package-x-generic",
            "items": [
              {
                "name": {
                  "en": "Add to TAR.GZ",
                  "ar": "إضافة إلى TAR.GZ"
                },
                "command": "peazip -add2gzip %file",
                "requires_binary": "peazip",
                "icon": "package-x-generic",
                "supported_extensions": [],
                "max_files": 100
              },
              {
                "name": {
                  "en": "Add to TAR.XZ",
                  "ar": "إضافة إلى TAR.XZ"
                },
                "command": "peazip -add2xz %file",
                "requires_binary": "peazip",
                "icon": "package-x-generic",
                "supported_extensions": [],
                "max_files": 100
              },
              {
                "name": {
                  "en": "Add to TAR.ZST",
                  "ar": "إضافة إلى TAR.ZST"
                },
                "command": "peazip -add2zstd %file",
                "requires_binary": "peazip",
                "icon": "package-x-generic",
                "supported_extensions": [],
                "max_files": 100
              }
            ]
          },
          {
            "group": {
              "en": "Advanced & Security",
              "ar": "حماية ومتقدم"
            },
            "icon": "preferences-system-security",
            "items": [
              {
                "name": {
                  "en": "Create Encrypted Archive (PEA)",
                  "ar": "إنشاء أرشيف مشفر (PEA)"
                },
                "command": "peazip -add2crypt %file",
                "requires_binary": "peazip",
                "icon": "dialog-password",
                "supported_extensions": [],
                "max_files": 100
              },
              {
                "name": {
                  "en": "Create SFX Archive (7Z)",
                  "ar": "أرشيف ذاتي الاستخراج (SFX)"
                },
                "command": "peazip -add2sfx7z %file",
                "requires_binary": "peazip",
                "icon": "application-x-executable",
                "supported_extensions": [],
                "max_files": 100
              },
              {
                "name": {
                  "en": "Split into Volumes",
                  "ar": "تقسيم الملف إلى أجزاء"
                },
                "command": "peazip -add2split %file",
                "requires_binary": "peazip",
                "icon": "view-split-left-right",
                "supported_extensions": [],
                "max_files": 1
              }
            ]
          }
        ]
      }
    ]
  }
}