# PeaZipMenu — ClickMesh-generated service menu for Dolphin (KDE).
#
# Installation:
#   KDE Plasma 5 :  ~/.local/share/kservices5/ServiceMenus/
#   KDE Plasma 6 :  ~/.local/share/kio/servicemenus/
#
# After copying, restart Dolphin or run:  kbuildsycoca6 (or kbuildsycoca5)

[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=application/octet-stream;inode/directory;
X-KDE-Submenu=PeaZip
X-KDE-Submenu[ar]=بيزيب
Icon=peazip
Actions=Action0;Action1;Action2;Action3;Action4;Action5;Action6;Action7;Action8;

[Desktop Action Action0]
Name=Add to Archive ▸ Add to Archive...
Name[ar]=إضافة لأرشيف ▸ إضافة لأرشيف... (خيارات)
Icon=archive-insert
Exec=peazip -add2archive %F

[Desktop Action Action1]
Name=Add to Archive ▸ Add to ZIP
Name[ar]=إضافة لأرشيف ▸ إضافة إلى ZIP
Icon=package-x-generic
Exec=peazip -add2zip %F

[Desktop Action Action2]
Name=Add to Archive ▸ Add to 7Z
Name[ar]=إضافة لأرشيف ▸ إضافة إلى 7Z
Icon=package-x-generic
Exec=peazip -add27z %F

[Desktop Action Action3]
Name=Add to Archive ▸ Other Formats ▸ Add to TAR.GZ
Name[ar]=إضافة لأرشيف ▸ صيغ أخرى ▸ إضافة إلى TAR.GZ
Icon=package-x-generic
Exec=peazip -add2gzip %F

[Desktop Action Action4]
Name=Add to Archive ▸ Other Formats ▸ Add to TAR.XZ
Name[ar]=إضافة لأرشيف ▸ صيغ أخرى ▸ إضافة إلى TAR.XZ
Icon=package-x-generic
Exec=peazip -add2xz %F

[Desktop Action Action5]
Name=Add to Archive ▸ Other Formats ▸ Add to TAR.ZST
Name[ar]=إضافة لأرشيف ▸ صيغ أخرى ▸ إضافة إلى TAR.ZST
Icon=package-x-generic
Exec=peazip -add2zstd %F

[Desktop Action Action6]
Name=Add to Archive ▸ Advanced & Security ▸ Create Encrypted Archive (PEA)
Name[ar]=إضافة لأرشيف ▸ حماية ومتقدم ▸ إنشاء أرشيف مشفر (PEA)
Icon=dialog-password
Exec=peazip -add2crypt %F

[Desktop Action Action7]
Name=Add to Archive ▸ Advanced & Security ▸ Create SFX Archive (7Z)
Name[ar]=إضافة لأرشيف ▸ حماية ومتقدم ▸ أرشيف ذاتي الاستخراج (SFX)
Icon=application-x-executable
Exec=peazip -add2sfx7z %F

[Desktop Action Action8]
Name=Add to Archive ▸ Advanced & Security ▸ Split into Volumes
Name[ar]=إضافة لأرشيف ▸ حماية ومتقدم ▸ تقسيم الملف إلى أجزاء
Icon=view-split-left-right
Exec=peazip -add2split %F
