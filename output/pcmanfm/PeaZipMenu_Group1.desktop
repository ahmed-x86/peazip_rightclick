# PeaZipMenu — ClickMesh-generated custom action for PCManFM / PCManFM-Qt.
#
# Installation:
#   PCManFM (GTK)  :  ~/.local/share/file-manager/actions/
#   PCManFM-Qt     :  ~/.local/share/file-manager/actions/
#
# After copying, restart PCManFM to pick up the new actions.

[Desktop Entry]
Type=Action
Name=PeaZip
Name[ar]=بيزيب
Icon=peazip
Profiles=default;
MimeTypes=application/octet-stream;application/vnd.ms-cab-compressed;application/vnd.rar;application/x-7z-compressed;application/x-tar;application/zip;application/zstd;inode/directory;
TargetLocation=true
Actions=Action0;Action1;Action2;Action3;Action4;Action5;

[Desktop Action Action0]
Name=Open Archive
Name[ar]=فتح الأرشيف
Icon=peazip
Exec=peazip -ext2browse %F

[Desktop Action Action1]
Name=Extract ▸ Extract Here
Name[ar]=استخراج ▸ استخراج هنا
Icon=archive-extract
Exec=peazip -ext2here %F

[Desktop Action Action2]
Name=Extract ▸ Extract to Folder
Name[ar]=استخراج ▸ استخراج إلى مجلد
Icon=folder-new
Exec=peazip -ext2newfolder %F

[Desktop Action Action3]
Name=Extract ▸ Extract to... (Choose Folder)
Name[ar]=استخراج ▸ استخراج إلى... (اختيار المجلد)
Icon=folder-open
Exec=peazip -ext2to %F

[Desktop Action Action4]
Name=Extract ▸ Extract with Options...
Name[ar]=استخراج ▸ استخراج بخيارات...
Icon=preferences-system
Exec=peazip -ext2main %F

[Desktop Action Action5]
Name=Extract ▸ Test Archive
Name[ar]=استخراج ▸ فحص الأرشيف
Icon=emblem-ok-symbolic
Exec=peazip -ext2test %F
